# Copy to .env and fill in. Never commit the real .env (already gitignored).

# --- Required ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=              # only needed for semantic_search (embeddings) + build_content_index.py

# --- Neo4j ---
# Unset (or pointed at localhost) = local docker-compose Neo4j, matches docker-compose.yml.
# Set these to point app.py at a remote instance instead (e.g. the EC2 one from
# setup_neo4j_ec2.sh) -- no code change needed, graph_store.py/app.py already read these.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme-local-pw# local-dev only -- use a real password for anything remote

# --- Qdrant ---
# Unset = local on-disk collection at data/qdrant_storage/ (semantic_index.py's default).
# Set QDRANT_HOST to point at a remote/deployed Qdrant instead (e.g. after running
# migrate_qdrant_to_remote.py) -- semantic_index.get_client() picks remote mode automatically
# whenever QDRANT_HOST is set, local mode otherwise.
QDRANT_HOST=10.0.136.27
QDRANT_PORT=6333
QDRANT_API_KEY=               # only if the remote Qdrant deployment requires one
